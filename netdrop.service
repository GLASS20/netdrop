[Unit]
Description=Podman Container Network Dropper
After=network-online.target podman.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/netdrop
ExecStart=/usr/local/bin/netdrop daemon
Restart=always
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
